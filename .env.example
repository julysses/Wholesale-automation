# ════════════════════════════════════════════════════════════════════════════════
# WholesaleOS — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ════════════════════════════════════════════════════════════════════════════════

# ── Anthropic (required — powers all 4 AI agents) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase (required for React/WholesaleOS auth + data storage) ─────────────
# Get these from: https://supabase.com → your project → Settings → API
# The anon key is public-safe (RLS enforced). Both are read by /api/config so
# the React build doesn't need them baked in at compile time.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000

# Comma-separated list of allowed CORS origins.
# In production add your domain: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, fine for production with Docker volume mount):
DATABASE_URL=sqlite:///./data/wholesale_agency.db
# PostgreSQL (recommended for multi-instance / Railway / Render):
# DATABASE_URL=postgresql://user:password@host:5432/wholesale_agency

# ── Agency Identity (used in compliant outreach templates) ────────────────────
AGENCY_NAME=Texas Wholesale Solutions
AGENCY_STATE=TX
AGENCY_CONTACT_NAME=Alex
AGENCY_PHONE=

# ── Lead Pipeline ─────────────────────────────────────────────────────────────
DISTRESS_SCORE_THRESHOLD=45
OUTREACH_COOLDOWN_DAYS=30

# ── Outreach Limits (Section 4) ───────────────────────────────────────────────
MAX_SELLER_FOLLOWUPS=1            # Max 1 follow-up without seller reply, then hard stop
MAX_OUTREACH_ATTEMPTS=2           # Total: 1 first touch + 1 follow-up
MAX_CHANNELS_PER_CONTACT_PER_DAY=1

# ── TCPA / Texas Scheduling (Section 5) ──────────────────────────────────────
TEXAS_TIMEZONE=America/Chicago
TCPA_ALLOWED_START_HOUR=9         # 9:00am CT
TCPA_ALLOWED_END_HOUR=19          # 7:00pm CT
SMS_WEEKEND_BLOCKED=true          # Block SMS on Sat/Sun unless seller-initiated

# ── DNC Enforcement ───────────────────────────────────────────────────────────
DNC_CHECK_ENABLED=true
DNC_PROVIDER=                     # dataaxle | contact_center_compliance
DNC_PROVIDER_API_KEY=
NUMVERIFY_API_KEY=

# ── SMS Provider — A2P 10DLC (Section 5) ─────────────────────────────────────
# Approved: twilio | telnyx | messagebird
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELNYX_API_KEY=
MESSAGEBIRD_API_KEY=

# ── Email Provider (Section 5) ────────────────────────────────────────────────
# Approved: sendgrid | mailgun | instantly
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAILGUN_API_KEY=
FROM_EMAIL=

# ── Data Providers ────────────────────────────────────────────────────────────
PROPSTREAM_API_KEY=
BATCHLEADS_API_KEY=
