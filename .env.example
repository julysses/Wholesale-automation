# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=sqlite:///./wholesale_agency.db

# SMS Provider (e.g. Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Data Providers (toggle on when subscribed)
PROPSTREAM_API_KEY=
BATCHLEADS_API_KEY=

# Agency Settings
AGENCY_NAME=Texas Wholesale Solutions
AGENCY_STATE=TX
DISTRESS_SCORE_THRESHOLD=45
MAX_OUTREACH_ATTEMPTS=2
OUTREACH_COOLDOWN_DAYS=30

# Compliance
DNC_CHECK_ENABLED=true
TCPA_QUIET_HOURS_START=21
TCPA_QUIET_HOURS_END=8
