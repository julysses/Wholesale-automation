# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./wholesale_agency.db

# ── Agency Identity (used in outreach templates) ──────────────────────────────
AGENCY_NAME=Texas Wholesale Solutions
AGENCY_STATE=TX
AGENCY_CONTACT_NAME=Alex          # First name used in approved templates
AGENCY_PHONE=                     # Displayed in emails for CAN-SPAM compliance

# ── Lead Pipeline ─────────────────────────────────────────────────────────────
DISTRESS_SCORE_THRESHOLD=45
OUTREACH_COOLDOWN_DAYS=30

# ── Outreach Limits (Section 4) ───────────────────────────────────────────────
MAX_SELLER_FOLLOWUPS=1            # Max 1 follow-up without seller reply (then hard stop)
MAX_OUTREACH_ATTEMPTS=2           # Total: 1 first touch + 1 follow-up
MAX_CHANNELS_PER_CONTACT_PER_DAY=1

# ── TCPA / Texas Scheduling (Section 5) ──────────────────────────────────────
TEXAS_TIMEZONE=America/Chicago
TCPA_ALLOWED_START_HOUR=9         # 9:00am CT
TCPA_ALLOWED_END_HOUR=19          # 7:00pm CT
SMS_WEEKEND_BLOCKED=true          # Block SMS Sat/Sun unless seller initiated

# ── DNC Enforcement ───────────────────────────────────────────────────────────
DNC_CHECK_ENABLED=true
DNC_PROVIDER=                     # dataaxle | contact_center_compliance
DNC_PROVIDER_API_KEY=
NUMVERIFY_API_KEY=                # Phone validation

# ── SMS Provider — A2P 10DLC (Section 5) ─────────────────────────────────────
# Approved: twilio | telnyx | messagebird
SMS_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Telnyx (alternative)
TELNYX_API_KEY=

# MessageBird (alternative)
MESSAGEBIRD_API_KEY=

# ── Email Provider (Section 5) ────────────────────────────────────────────────
# Approved: sendgrid | mailgun | instantly
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAILGUN_API_KEY=
FROM_EMAIL=

# ── Data Providers (toggle when subscribed) ───────────────────────────────────
PROPSTREAM_API_KEY=
BATCHLEADS_API_KEY=
