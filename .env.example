# ════════════════════════════════════════════════════════════════════════════════
# WholesaleOS — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ════════════════════════════════════════════════════════════════════════════════

# ── Anthropic (required — powers all 4 AI agents) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub Push Auth (agent runtime) ──────────────────────────────────────────
# Inject via secret manager only (do not commit real values in .env files).
# PAT scopes: fine-grained token with repo Contents: Read and write.
GITHUB_PAT=
GITHUB_USERNAME=x-access-token

# ── Supabase (required for React/WholesaleOS auth + data storage) ─────────────
# Get these from: https://supabase.com → your project → Settings → API
# The anon key is public-safe (RLS enforced). Both are read by /api/config so
# the React build doesn't need them baked in at compile time.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Optional backend-style aliases. /api/config falls back to these when VITE_ vars
# are not set, which is useful on hosts that share backend and frontend config.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000

# Comma-separated list of allowed CORS origins.
# In production add your domain: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
# Set CORS_STRICT=true to restrict the API to CORS_ORIGINS (+ *.vercel.app preview
# domains). Leave false to allow any origin (needed for embeddable /api/forms/* widgets).
CORS_STRICT=false
# Set WEBHOOK_STRICT=true in production to reject inbound webhooks whose secret is
# not configured (fail closed). Default false allows them for local/dev (logged).
WEBHOOK_STRICT=true

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, fine for production with Docker volume mount):
DATABASE_URL=sqlite:///./data/wholesale_agency.db
# PostgreSQL (recommended for multi-instance / Railway / Render):
# DATABASE_URL=postgresql://user:password@host:5432/wholesale_agency

# ── Agency Identity (used in compliant outreach templates) ────────────────────
AGENCY_NAME=Texas Wholesale Solutions
AGENCY_STATE=TX
AGENCY_CONTACT_NAME=Alex
AGENCY_PHONE=

# ── Lead Pipeline ─────────────────────────────────────────────────────────────
DISTRESS_SCORE_THRESHOLD=45
OUTREACH_COOLDOWN_DAYS=30

# ── Outreach Limits (Section 4) ───────────────────────────────────────────────
MAX_SELLER_FOLLOWUPS=1            # Max 1 follow-up without seller reply, then hard stop
MAX_OUTREACH_ATTEMPTS=2           # Total: 1 first touch + 1 follow-up
MAX_CHANNELS_PER_CONTACT_PER_DAY=1

# ── TCPA / Texas Scheduling (Section 5) ──────────────────────────────────────
TEXAS_TIMEZONE=America/Chicago
TCPA_ALLOWED_START_HOUR=9         # 9:00am CT
TCPA_ALLOWED_END_HOUR=19          # 7:00pm CT
SMS_WEEKEND_BLOCKED=true          # Block SMS on Sat/Sun unless seller-initiated

# ── DNC Enforcement ───────────────────────────────────────────────────────────
DNC_CHECK_ENABLED=true
DNC_PROVIDER=                     # dataaxle | contact_center_compliance
DNC_PROVIDER_API_KEY=
NUMVERIFY_API_KEY=

# ── SMS Provider — A2P 10DLC (Section 5) ─────────────────────────────────────
# Approved: twilio | telnyx | messagebird
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
MESSAGEBIRD_API_KEY=
MESSAGEBIRD_ORIGINATOR=Texas Wholesale

# ── Email Provider (Section 5) ────────────────────────────────────────────────
# Approved: sendgrid | mailgun | instantly
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAILGUN_API_KEY=
FROM_EMAIL=

# ── Data Providers ────────────────────────────────────────────────────────────
PROPSTREAM_API_KEY=
BATCHLEADS_API_KEY=
# RealtyAPI.io — used by Supabase Edge Functions (enrich-property, pull-comps,
# compute-arv, rental-yield, motivated-seller-scan, market-pulse). Set this as a
# Supabase Functions secret, not just here. See PR #1.
REALTYAPI_KEY=

# ════════════════════════════════════════════════════════════════════════════════
# OUTREACH AUTOMATION PIPELINE (blueprint integrations)
# ════════════════════════════════════════════════════════════════════════════════

# ── BatchData / BatchSkipTracing ──────────────────────────────────────────────
# Used to enrich phone numbers + emails before scoring.
# https://developer.batchdata.com
BATCHDATA_API_KEY=

# ── BatchDialer ───────────────────────────────────────────────────────────────
# Tier A + B leads are pushed here for outbound calling.
# https://developer.batchdialer.com
BATCHDIALER_API_KEY=
BATCHDIALER_DEFAULT_CAMPAIGN_ID=   # Create campaign in BatchDialer UI first
BATCHDIALER_WEBHOOK_SECRET=        # Set in BatchDialer → Webhooks → call completed

# ── Retell AI ─────────────────────────────────────────────────────────────────
# AI calling platform. Set the webhook URL in your Retell dashboard to:
#   https://<your-domain>/webhooks/retell
# Use the API key designated in Retell for webhook verification.
# Leave blank to verify with RETELL_API_KEY; do not generate an unrelated secret.
RETELL_WEBHOOK_SECRET=             # Designated Retell webhook API key; defaults to RETELL_API_KEY if shared

# ── Readymode (adapter slot) ──────────────────────────────────────────────────
READYMODE_API_KEY=
READYMODE_WEBHOOK_URL=

# ── Launch Control SMS ────────────────────────────────────────────────────────
# Tier C leads are enrolled in SMS nurture via Launch Control.
# Mode: zapier_webhook (default) | csv_sync | api_direct
LAUNCH_CONTROL_MODE=zapier_webhook
LAUNCH_CONTROL_ZAPIER_HOOK_URL=    # From Zapier → your Launch Control Zap → trigger URL
LAUNCH_CONTROL_API_KEY=            # Only if your account rep provides private API access
LAUNCH_CONTROL_DEFAULT_CAMPAIGN=Nurture Sequence
LAUNCH_CONTROL_WEBHOOK_SECRET=     # For verifying inbound reply webhooks

# ── Podio CRM ─────────────────────────────────────────────────────────────────
# Optional — if using Podio as system-of-record CRM.
PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=
PODIO_APP_ID_LEADS=
PODIO_APP_TOKEN_LEADS=

# ── REsimpli CRM ──────────────────────────────────────────────────────────────
# Optional — if using REsimpli as system-of-record CRM.
RESIMPLI_API_KEY=
RESIMPLI_WEBHOOK_URL=

# ── Notifications ─────────────────────────────────────────────────────────────
# Slack DM when a lead goes HOT or APPOINTMENT_SET.
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL=
# Owner/team phone number for immediate speed-to-lead SMS alerts on every new
# inbound web-form lead (see _send_lead_pipeline_sms in web/api/lead_forms_api.py).
OWNER_ALERT_PHONE_NUMBER=

# ── Supabase Service Role (server-side writes from webhooks) ──────────────────
# NEVER expose this in the frontend. Only used by FastAPI webhook handlers.
SUPABASE_SERVICE_ROLE_KEY=

# ── Seller Score Routing ──────────────────────────────────────────────────────
# A=70+ B=50-69 C=30-49 D<30
# Set to true to automatically push A/B leads to BatchDialer after scoring.
AUTO_PUSH_TO_DIALER=false          # Set true when BatchDialer is configured
AUTO_ENROLL_SMS_NURTURE=false      # Set true when Launch Control is configured
AUTO_SKIP_TRACE=true               # Run BatchData skip trace on every ingested lead
