    {
      "name": "buckets_lifecycle_configuration_pair_check",
      "table": "buckets",
      "schema": "storage",
      "definition": "CHECK (((lifecycle_configuration IS NULL) = (lifecycle_configuration_generation IS NULL)))"
    },
    {
      "name": "buckets_lifecycle_configuration_shape_check",
      "table": "buckets",
      "schema": "storage",
      "definition": "CHECK (((lifecycle_configuration IS NULL) OR ((jsonb_typeof(lifecycle_configuration) = 'object'::text) AND (lifecycle_configuration ? 'rules'::text) AND\nCASE\n    WHEN (jsonb_typeof((lifecycle_configuration -> 'rules'::text)) = 'array'::text) THEN ((jsonb_array_length((lifecycle_configuration -> 'rules'::text)) >= 1) AND (jsonb_array_length((lifecycle_configuration -> 'rules'::text)) <= 1000))\n    ELSE false\nEND)))"
    },
    {
      "name": "buckets_lifecycle_configuration_standard_only_check",
      "table": "buckets",
      "schema": "storage",
      "definition": "CHECK (((type = 'STANDARD'::storage.buckettype) OR ((lifecycle_configuration IS NULL) AND (lifecycle_configuration_generation IS NULL))))"
    },
    {
      "name": "buckets_pkey",
      "table": "buckets",
      "schema": "storage",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "buckets_versioning_dark_check",
      "table": "buckets",
      "schema": "storage",
      "definition": "CHECK ((versioning_status = 'DISABLED'::text))"
    },
    {
      "name": "buckets_versioning_standard_only_check",
      "table": "buckets",
      "schema": "storage",
      "definition": "CHECK (((type = 'STANDARD'::storage.buckettype) OR (versioning_status = 'DISABLED'::text)))"
